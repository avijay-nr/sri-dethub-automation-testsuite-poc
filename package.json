{
  "name": "sri-testautomationsuite-poc",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation framework for SRI projects",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:sri:open": "playwright test tests/SpecFiles/SRILogindef.spec.ts --project=chrome",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.2"
  }
}
